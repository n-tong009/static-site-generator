---
title: '仕事終わりに、呼吸を戻す整体'
description: 'デスクワーク疲れに寄り添う、やさしい整体サロン。初回お試し3,980円。肩こり・腰痛・睡眠の悩みをご相談ください。'
layout: 'LpLayout'
pageId: 'index'
ogImage: '/images/532x300_green.png'
---

<!-- ===================== HERO ===================== -->
<section class="lp-hero" id="top" aria-label="整体サロン Relax メインビジュアル">
  <div class="lp-hero__grid">
    <div class="lp-hero__copy reveal">
      <h1 class="lp-hero__title">
        仕事終わりに、
        <br />
        呼吸を戻す整体
        <svg class="lp-hero__swoosh" viewBox="0 0 91 42" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path
            d="M1.00027 41.0094C37.1155 26.6495 55.4007 20.6994 77.0003 19.5C85.8097 19.0108 90.0003 21.5095 90.0003 21.5095M43.5003 20.0094C61.2784 13.8886 69.5003 10.0406 69.5003 6.00948C69.5003 -0.990517 61.5003 0.509513 57.0003 3.50944M61.5003 32.0095C72.1125 28.6084 75.0003 28.0095 78.0003 31.0095"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </h1>
      <p class="lp-hero__lead">
        デスクワークで固まった首・肩・腰に。
        <br />
        深い呼吸と、軽やかな毎日を取り戻す時間。
      </p>
      <div class="lp-hero__chips">
        <% data.seitai.hero.chips.forEach(function (chip) { %>
        <span class="lp-chip"><%- render('icon/' + chip.icon, { iconClass: 'lp-chip__icon' }) %> <%= chip.label %></span>
        <% }) %>
      </div>
      <div class="lp-hero__cta">
        <a class="lp-btn lp-btn--primary" href="#"><%- render('icon/CalendarCheck', { iconClass: 'lp-btn__icon' }) %> <%= data.seitai.hero.ctaText %></a>
        <span class="lp-hero__note"><%= data.seitai.hero.note %></span>
      </div>
    </div>
    <div class="lp-hero__visual ph">
      <span class="ph-glyph"><%- render('icon/Image', { iconClass: 'ph-glyph__icon' }) %></span>
      <span class="ph-tag">hero photo</span>
    </div>
  </div>
</section>

<!-- ===================== WORRIES ===================== -->
<section class="lp-worries" id="worries" aria-labelledby="worries-title">
  <h2 class="lp-section-head__title reveal" id="worries-title">
    こんな<span class="lp-accent">お悩み</span>、ありませんか？
  </h2>
  <div class="lp-underline reveal"></div>
  <div class="lp-worry-grid">
    <% data.seitai.concerns.forEach(function (item) { %>
    <div class="lp-worry-card reveal">
      <span class="lp-worry-ico"><%- render('icon/' + item.icon, { iconClass: 'lp-worry-ico__svg' }) %></span>
      <p class="lp-worry-card__text"><%= item.text %></p>
    </div>
    <% }) %>
  </div>
</section>

<!-- ===================== APPROACH ===================== -->
<section class="lp-approach" id="approach" aria-labelledby="approach-title">
  <h2 class="lp-section-head__title reveal" id="approach-title">
    当院の<span class="lp-accent">アプローチ</span>
  </h2>
  <div class="lp-underline reveal"></div>
  <div class="lp-approach__list">
    <% data.seitai.approach.forEach(function (item, i) { %>
    <div class="lp-approach-row reveal">
      <div class="lp-approach-row__thumb ph">
        <span class="ph-glyph"><%- render('icon/Image', { iconClass: 'ph-glyph__icon' }) %></span>
        <span class="ph-tag"><%= item.imageLabel %></span>
      </div>
      <div class="lp-approach-row__body">
        <span class="lp-approach-row__num"><%= i + 1 %></span>
        <div class="lp-approach-row__text">
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- ===================== SPACE ===================== -->
<section class="lp-space" id="space" aria-labelledby="space-title">
  <h2 class="lp-section-head__title reveal" id="space-title">
    落ち着ける、<span class="lp-accent">やさしい空間</span>
  </h2>
  <div class="lp-underline reveal"></div>
  <div class="lp-space__grid">
    <% data.seitai.space.images.forEach(function (item) { %>
    <div class="lp-space__item ph reveal">
      <span class="ph-glyph"><%- render('icon/Image', { iconClass: 'ph-glyph__icon' }) %></span>
      <span class="ph-tag"><%= item.label %></span>
    </div>
    <% }) %>
  </div>
  <p class="lp-space__cap reveal"><%= data.seitai.space.lead %></p>
</section>

<!-- ===================== PRICING ===================== -->
<section class="lp-pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="lp-price-card reveal">
    <div class="lp-price-info">
      <span class="lp-price-badge"><%= data.seitai.pricing.eyebrow %></span>
      <h2 class="lp-price-title" id="pricing-title"><%= data.seitai.pricing.label %></h2>
      <div class="lp-price-tags">
        <span class="lp-chip">カウンセリング込み</span>
        <span class="lp-chip">約60分</span>
      </div>
    </div>
    <div class="lp-price-amount">
      <div class="lp-price-was">
        通常価格
        <s><%= data.seitai.pricing.regular.toLocaleString() %></s>
        円
      </div>
      <div class="lp-price-arrow"><%- render('icon/ChevronDown', { iconClass: 'lp-price-arrow__icon' }) %></div>
      <div class="lp-price-now">
        <span class="lp-price-num"><%= data.seitai.pricing.sale.toLocaleString() %></span>
        <span class="lp-price-yen">円</span>
        <span class="lp-price-tax">（税込）</span>
      </div>
    </div>
    <div class="lp-price-cta">
      <a class="lp-btn lp-btn--primary" href="#">
        <%- render('icon/CalendarCheck', { iconClass: 'lp-btn__icon' }) %> 今すぐ予約する
        <br />
        （LINE予約）
      </a>
      <span class="lp-price-sub"><%= data.seitai.pricing.ctaNote %></span>
    </div>
  </div>
</section>

<!-- ===================== FAQ ===================== -->
<section class="lp-faq" id="faq" aria-labelledby="faq-title">
  <h2 class="lp-section-head__title reveal" id="faq-title">
    よくある<span class="lp-accent">ご質問</span>
  </h2>
  <div class="lp-underline reveal"></div>
  <div class="lp-faq__list">
    <% data.seitai.faq.forEach(function (item) { %>
    <div class="lp-faq__item reveal">
      <details class="lp-faq__details">
        <summary class="lp-faq__question">
          <span class="lp-faq__q-label">Q</span>
          <span class="lp-faq__q-text"><%= item.q %></span>
          <span class="lp-faq__chevron"><%- render('icon/ChevronDown', { iconClass: 'lp-faq__chevron-icon' }) %></span>
        </summary>
        <div class="lp-faq__answer"><%= item.a %></div>
      </details>
    </div>
    <% }) %>
  </div>
</section>

<!-- ===================== CLOSING ===================== -->
