<%
// Footer.ejs
const currentYear = new Date().getFullYear()
const salon = data.site || {}
const instagramUrl = salon.sns?.instagram || 'https://www.instagram.com/'
%>
<footer id="section-footer">
  <div class="container">
    <div class="footer-brand">
      <p class="footer-logo"><%= SITE_CONFIG.name %></p>
      <p><%= salon.address || '' %></p>
      <% if (salon.businessHours) { %>
      <p>営業時間: <%= salon.businessHours %></p>
      <% } %>
    </div>

    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <ul>
        <li><a href="<%= url('/') %>#concerns">お悩み</a></li>
        <li><a href="<%= url('/') %>#approach">アプローチ</a></li>
        <li><a href="<%= url('/') %>#space">空間</a></li>
        <li><a href="<%= url('/') %>#pricing">料金</a></li>
        <li><a href="<%= url('/') %>#faq">FAQ</a></li>
      </ul>
    </nav>

    <div class="social-links">
      <a href="<%= instagramUrl %>" target="_blank" rel="noopener noreferrer" class="social-link instagram">Instagram</a>
    </div>

    <p class="copyright">&copy; <%= currentYear %> <%= SITE_CONFIG.name %></p>
  </div>
</footer>
